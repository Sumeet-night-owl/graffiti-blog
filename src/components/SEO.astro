---
import { SITE_TITLE } from '../consts';
import { absoluteUrl, withBase } from '../lib/urls';

export interface OgImage {
  /** Absolute URL or a path under the site. */
  src: string;
  width: number;
  height: number;
  alt: string;
}

export interface Article {
  publishedTime: Date;
  modifiedTime?: Date;
  author: string;
  tags: string[];
}

interface Props {
  title: string;
  description: string;
  image?: OgImage;
  article?: Article;
  /** For error pages: no canonical URL and not indexed. */
  noindex?: boolean;
}

const { title, description, image, article, noindex = false } = Astro.props;

const fullTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const og: OgImage = image ?? {
  src: withBase('og-default.png'),
  width: 1200,
  height: 630,
  alt: SITE_TITLE,
};
const ogImageUrl = absoluteUrl(og.src, Astro.site);
const ogImageType = /\.png$/i.test(new URL(ogImageUrl).pathname) ? 'image/png' : 'image/jpeg';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:width" content={String(og.width)} />
<meta property="og:image:height" content={String(og.height)} />
<meta property="og:image:alt" content={og.alt} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      )}
      <meta property="article:author" content={article.author} />
      {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={og.alt} />

<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={withBase('rss.xml')} />
<link rel="sitemap" href={withBase('sitemap-index.xml')} />
