---
import type { Post } from '../lib/posts';
import { postPath } from '../lib/urls';
import FormattedDate from './FormattedDate.astro';
import TagLinks from './TagLinks.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-card">
        <h2 class="post-card__title">
          <a href={postPath(post.id)}>{post.data.title}</a>
          {post.data.draft && <span class="draft-badge">Draft</span>}
        </h2>
        <p class="post-meta">
          <FormattedDate date={post.data.pubDate} /> · {post.data.author}
        </p>
        <p>{post.data.description}</p>
        <TagLinks tags={post.data.tags} />
      </li>
    ))
  }
</ul>
