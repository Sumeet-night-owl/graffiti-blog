---
import { tagPath } from '../lib/urls';

interface Props {
  tags: { slug: string; label: string }[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list" aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a class="tag" href={tagPath(tag.slug)}>
            {tag.label}
          </a>
        </li>
      ))}
    </ul>
  )
}
